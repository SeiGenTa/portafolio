---
import CardProject from "../components/cardsProjects.astro";
import CardsProjectsModal from "../components/cardsProjectsModal.astro";
import alara from "../assets/projects/alara.png";
import typescraft from "../assets/projects/typescraft.png";
import ggoo from "../assets/projects/ggoo.png";
---

<section id="projects">
  <h2 class="title-section">Proyectos</h2>
  <p class="section-subtitle">Algunos de mis trabajos más destacados</p>

  <div class="projects-grid pt-4">
    <CardProject
      title="ALARA"
      description="Alara es una startup innovadora en seguridad personal. Fui parte del equipo de desarrollo de la aplicación móvil, contribuyendo con funcionalidades clave para mejorar la experiencia del usuario."
      image={alara}
      url="https://alara.cl"
    />
    <CardProject
      title="TypesCraft"
      description="Framework frontend innovador que permite construir interfaces web usando únicamente TypeScript, eliminando la necesidad de HTML/CSS tradicional. Ofrece generación automática de componentes tipo-safe, manejo de estado integrado y un sistema de estilos basado en tipos."
      image={typescraft}
      url="https://typescraft.seigenta.cl"
    />
    <CardProject
      title="GGOO"
      description="GGOO es una aplicación open source para la comunidad de Volley Beauchef que automatiza el registro a pichangas, gestiona miembros y permite que administradores controlen permisos y validaciones en un solo lugar."
      image={ggoo}
      url="https://ggoo.seigenta.cl"
    />
  </div>
</section>

<style>
  #projects {
    width: 100%;
    max-width: var(--section-max-width);
    margin: 0 auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    padding: 0;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
