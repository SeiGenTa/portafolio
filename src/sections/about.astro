---
import { Image } from "astro:assets";
import perfilImg from "../assets/perfil.jpeg";

interface Capability {
  emoji: string;
  title: string;
  text: string;
  stack: string[];
}

const capabilities: Capability[] = [
  {
    emoji: "📱",
    title: "Desarrollo Móvil",
    text: "Apps multiplataforma con interfaces nativas, integraciones con APIs y manejo de estado reactivo.",
    stack: ["Flutter", "Dart", "REST APIs"],
  },
  {
    emoji: "📊",
    title: "Procesos de Datos Pesados",
    text: "Tareas asíncronas y microservicios que se comunican para paralelizar y reducir tiempos de respuesta.",
    stack: ["Celery", "Redis", "BullMQ"],
  },
  {
    emoji: "☁️",
    title: "Alta Disponibilidad & Cloud",
    text: "Arquitecturas tolerantes a fallos y pipelines de automatización para entrega continua confiable.",
    stack: ["Docker", "VPS", "CI/CD"],
  },
];

const tags = [
  "Web Development",
  "Mobile Apps",
  "Machine Learning",
  "Ciberseguridad",
  "High Availability",
  "Data Pipelines",
];

const stats = [
  { value: "1+", label: "Años de experiencia" },
  { value: "15+", label: "Proyectos" },
  { value: "15+", label: "Tecnologías" },
];
---

<section id="about_me">
  <h2 class="title-section">Sobre mí</h2>
  <p class="section-subtitle">Un poco de quién soy y en qué me especializo</p>

  <div class="about-container">
    <aside class="about-aside">
      <div class="info-card profile-card">
        <div class="image-frame">
          <Image
            src={perfilImg}
            alt="Retrato de Álvaro Martínez"
            class="profile-image"
            width={220}
            height={220}
            loading="lazy"
          />
        </div>
        <div class="profile-meta">
          <h3 class="profile-name">Álvaro Martínez</h3>
          <p class="profile-role">Ingeniero Civil en Computación</p>
        </div>
      </div>

      <div class="info-card intro-card">
        <span class="card-label">Presentación</span>
        <p class="intro-text">
          Apasionado por crear soluciones tecnológicas robustas, con foco en
          desarrollo web, móvil y procesamiento de datos a escala.
        </p>
      </div>

      <div class="info-card stats-card">
        <span class="card-label">En números</span>
        <div class="stats-grid">
          {
            stats.map((stat) => (
              <div class="stat">
                <span class="stat-value">{stat.value}</span>
                <span class="stat-label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="info-card tags-card">
        <span class="card-label">Áreas de Expertise</span>
        <div class="expertise-tags">
          {
            tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))
          }
        </div>
      </div>
    </aside>

    <div class="about-main">
      <div class="capabilities-grid">
        {
          capabilities.map((cap) => (
            <article class="info-card capability-card">
              <div class="capability-header">
                <span class="capability-emoji" aria-hidden="true">
                  {cap.emoji}
                </span>
                <h3 class="capability-title">{cap.title}</h3>
              </div>
              <p class="capability-text">{cap.text}</p>
              <div class="capability-stack">
                {
                  cap.stack.map((tech) => (
                    <span class="tech-pill">{tech}</span>
                  ))
                }
              </div>
            </article>
          ))
        }
      </div>

      <article class="info-card highlight-card">
        <div class="highlight-header">
          <span class="highlight-emoji" aria-hidden="true">🚀</span>
          <div>
            <span class="card-label">Experiencia Destacada</span>
            <h3 class="highlight-title">Alara · Flutter</h3>
          </div>
        </div>
        <p class="highlight-text">
          En <strong>Alara</strong>, una startup enfocada en seguridad
          innovadora, desarrollé una aplicación móvil con
          <strong>Flutter</strong>, combinando perspectivas técnicas y de
          seguridad.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  #about_me {
    width: 100%;
    max-width: var(--section-max-width);
    margin: 0 auto;
  }

  .section-subtitle {
    margin-bottom: 48px;
  }

  .about-container {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 24px;
    align-items: start;
  }

  /* Aside (columna izquierda) */
  .about-aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: sticky;
    top: calc(var(--app-bar-height) + 24px);
  }

  /* Card base - estilo compartido */
  .info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 20px;
    transition:
      border-color var(--transition),
      background var(--transition),
      transform var(--transition);
  }

  .info-card:hover {
    border-color: var(--border-strong);
    background: var(--white-08);
  }

  .card-label {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 10px;
  }

  /* Profile card */
  .profile-card {
    text-align: center;
    padding: 24px 20px;
  }

  .image-frame {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--border);
    margin: 0 auto 16px;
    box-shadow: var(--shadow-md);
    transition:
      transform var(--transition),
      border-color var(--transition);
  }

  .profile-card:hover .image-frame {
    transform: scale(1.03);
    border-color: var(--accent);
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .profile-name {
    margin: 0 0 4px;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.3px;
  }

  .profile-role {
    margin: 0;
    font-size: 0.88rem;
    color: var(--accent);
    font-weight: 500;
  }

  /* Intro card */
  .intro-card {
    border-left: 3px solid var(--accent);
  }

  .intro-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
    font-weight: 500;
  }

  /* Stats card */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2px;
    padding: 10px 4px;
    background: var(--white-05);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }

  .stat-value {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
    letter-spacing: -0.5px;
  }

  .stat-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 500;
    line-height: 1.2;
  }

  /* Tags card */
  .expertise-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    display: inline-block;
    padding: 4px 10px;
    background: var(--surface-strong);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
    transition: all var(--transition-fast);
  }

  .tag:hover {
    background: var(--white-15);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  /* Main (columna derecha) */
  .about-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  /* Capability card */
  .capability-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .capability-card:hover {
    transform: translateX(4px);
  }

  .capability-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .capability-emoji {
    font-size: 1.3rem;
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--accent-rgb), 0.12);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .capability-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.3px;
  }

  .capability-text {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .capability-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }

  .tech-pill {
    padding: 3px 10px;
    background: var(--white-05);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 600;
  }

  /* Highlight card (Alara) */
  .highlight-card {
    background: linear-gradient(
      135deg,
      rgba(var(--accent-rgb), 0.1),
      rgba(var(--accent-rgb), 0.03)
    );
    border: 1px solid rgba(var(--accent-rgb), 0.25);
    position: relative;
    overflow: hidden;
  }

  .highlight-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg, var(--accent), var(--accent-strong));
  }

  .highlight-card:hover {
    border-color: rgba(var(--accent-rgb), 0.4);
    background: linear-gradient(
      135deg,
      rgba(var(--accent-rgb), 0.13),
      rgba(var(--accent-rgb), 0.05)
    );
  }

  .highlight-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .highlight-header > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .highlight-header .card-label {
    margin-bottom: 0;
  }

  .highlight-emoji {
    font-size: 1.5rem;
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--accent-rgb), 0.15);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .highlight-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.3px;
  }

  .highlight-text {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .about-container {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .about-aside {
      position: static;
    }

    .profile-card {
      display: flex;
      align-items: center;
      gap: 16px;
      text-align: left;
    }

    .image-frame {
      width: 90px;
      height: 90px;
      margin: 0;
      flex-shrink: 0;
    }

    .profile-meta {
      flex: 1;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .stat {
      flex-direction: row;
      justify-content: space-between;
      padding: 10px 14px;
    }
  }
</style>
