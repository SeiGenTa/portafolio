---
import CardSkills from "../components/cardSkills.astro";
---

<section id="skills">
  <h3 class="title-section">Habilidades</h3>
  
  <div class="skills-container">
    <CardSkills
      title="Frontend"
      image="https://cdn.simpleicons.org/html5/ffffff"
      skills={["HTML", "CSS", "JavaScript", "TypeScript", "React", "Astro"]}
      skills_image={[
        "https://cdn.simpleicons.org/html5/ffffff",
        "https://cdn.simpleicons.org/css3/ffffff",
        "https://cdn.simpleicons.org/javascript/ffffff",
        "https://cdn.simpleicons.org/typescript/ffffff",
        "https://cdn.simpleicons.org/react/ffffff",
        "https://cdn.simpleicons.org/astro/ffffff"
      ]}
    />

    <CardSkills
      title="Backend"
      image="https://cdn.simpleicons.org/python/ffffff"
      skills={["Python", "Node.js", "Express", "FastAPI", "Flask", "Django"]}
      skills_image={[
        "https://cdn.simpleicons.org/python/ffffff",
        "https://cdn.simpleicons.org/node.js/ffffff",
        "https://cdn.simpleicons.org/express/ffffff",
        "https://cdn.simpleicons.org/fastapi/ffffff",
        "https://cdn.simpleicons.org/flask/ffffff",
        "https://cdn.simpleicons.org/django/ffffff"
      ]}
    />

    <CardSkills
      title="Database"
      image="https://cdn.simpleicons.org/mongodb/ffffff"
      skills={["MongoDB", "PostgreSQL", "MySQL", "Firebase", "SQLite"]}
      skills_image={[
        "https://cdn.simpleicons.org/mongodb/ffffff",
        "https://cdn.simpleicons.org/postgresql/ffffff",
        "https://cdn.simpleicons.org/mysql/ffffff",
        "https://cdn.simpleicons.org/firebase/ffffff",
        "https://cdn.simpleicons.org/sqlite/ffffff"
      ]}
    />
  </div>
</section>

<style>
  #skills {
    padding: 80px 0;
    max-width: 1200px;
    margin: 0 auto;
  }

  .skills-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
    margin-top: 40px;
  }

  .title-section {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 20px;
    color: var(--text);
  }
</style>
