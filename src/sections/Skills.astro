---
import CardSkills from "../components/cardSkills.astro";
---

<section id="skills">
  <h3 class="title-section">Habilidades</h3>
  
  <div class="skills-container">
    <CardSkills
      title="Frontend"
      image="frontend.png"
      skills={["HTML", "CSS", "JavaScript", "TypeScript", "React", "Astro"]}
      skills_image={[
        "html.png",
        "css.png",
        "javascript.png",
        "typescript.png",
        "react.png",
        "astro.png"
      ]}
    />

    <CardSkills
      title="Backend"
      image="backend.png"
      skills={["Python", "Node.js", "Express", "FastAPI", "Flask", "Django"]}
      skills_image={[
        "python.png",
        "nodejs.png",
        "express.png",
        "fastapi.png",
        "flask.png",
        "django.png"
      ]}
    />

    <CardSkills
      title="Database"
      image="db.png"
      skills={["MongoDB", "PostgreSQL", "MySQL", "Firebase", "SQLite"]}
      skills_image={[
        "mongodb.png",
        "postgresql.png",
        "mysql.png",
        "firebase.png",
        "sqlite.png"
      ]}
    />
  </div>
</section>

<style>
  #skills {
    padding: 80px 0;
    max-width: 1200px;
    margin: 0 auto;
  }

  .skills-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
    margin-top: 40px;
  }

  .title-section {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 20px;
    color: var(--text);
  }
</style>
