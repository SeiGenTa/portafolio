---
interface Props {
  title: string;
  description: string;
  image: string;
  details?: string;
  highlights?: string[];
  techStack?: string[];
  buttonText?: string;
}

const {
  title,
  description,
  image,
  details = description,
  highlights = [],
  techStack = [],
  buttonText = "Ver detalles",
} = Astro.props;

const modalId = `modal-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`;
---

<div class="project-modal-card" data-project-modal-card>
  <article class="card">
    <div class="card-image">
      <img src={image} alt={title} loading="lazy" />
      <div class="overlay"></div>
    </div>

    <div class="card-content">
      <h3 class="card-title">{title}</h3>
      <p class="card-description">{description}</p>

      <button
        type="button"
        class="card-link"
        aria-haspopup="dialog"
        aria-controls={modalId}
        data-modal-open
      >
        <span>{buttonText}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
      </button>
    </div>
  </article>

  <div class="modal" id={modalId} role="dialog" aria-modal="true" aria-labelledby={`${modalId}-title`} data-modal>
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-content">
      <button type="button" class="modal-close" aria-label="Cerrar modal" data-modal-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>

      <h4 id={`${modalId}-title`} class="modal-title">{title}</h4>
      <p class="modal-description">{details}</p>

      {highlights.length > 0 && (
        <section class="modal-section">
          <h5>Puntos clave</h5>
          <ul>
            {highlights.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {techStack.length > 0 && (
        <section class="modal-section">
          <h5>Tecnologias</h5>
          <div class="stack-tags">
            {techStack.map((tech) => <span>{tech}</span>)}
          </div>
        </section>
      )}
    </div>
  </div>
</div>

<style>
  .project-modal-card {
    position: relative;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 520px;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2);
  }

  .card-image {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover .card-image img {
    transform: scale(1.1);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.6) 100%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .card:hover .overlay {
    opacity: 1;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px 20px;
    gap: 12px;
    flex: 1;
  }

  .card-title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.5px;
    line-height: 1.3;
  }

  .card-description {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.05));
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    margin-top: 8px;
    width: fit-content;
    cursor: pointer;
    appearance: none;
  }

  .card-link:hover {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.15));
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateX(4px);
  }

  .card-link svg {
    width: 18px;
    height: 18px;
    transition: transform 0.25s ease;
  }

  .card-link:hover svg {
    transform: rotate(90deg);
  }

  .modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
  }

  .modal.is-open {
    display: block;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: relative;
    width: min(640px, calc(100% - 2rem));
    max-height: 85vh;
    overflow-y: auto;
    margin: 7vh auto 0;
    background: linear-gradient(145deg, rgba(25, 32, 48, 0.96), rgba(15, 20, 32, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    padding: 28px 24px;
    color: var(--text);
    transform: translateY(16px);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .modal.is-open .modal-content {
    transform: translateY(0);
    opacity: 1;
  }

  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: rotate(90deg);
  }

  .modal-title {
    margin: 0 0 12px;
    padding-right: 40px;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .modal-description {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .modal-section {
    margin-top: 18px;
  }

  .modal-section h5 {
    margin: 0 0 10px;
    font-size: 0.95rem;
    letter-spacing: 0.3px;
    color: var(--text);
  }

  .modal-section ul {
    margin: 0;
    padding-left: 1rem;
    color: var(--text-secondary);
  }

  .modal-section li {
    margin-bottom: 6px;
    line-height: 1.4;
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack-tags span {
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  :global(body.modal-open) {
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .card-title {
      font-size: 1.2rem;
    }

    .card-description {
      font-size: 0.85rem;
    }

    .modal-content {
      margin-top: 5vh;
      padding: 22px 18px;
    }
  }
</style>

<script>
  const closeModal = (modal: HTMLElement | null) => {
    if (!modal) {
      return;
    }

    modal.classList.remove("is-open");
    const hasAnyModalOpen = document.querySelector(".modal.is-open");
    if (!hasAnyModalOpen) {
      document.body.classList.remove("modal-open");
    }
  };

  const cards = document.querySelectorAll("[data-project-modal-card]");

  cards.forEach((card) => {
    const openButton = card.querySelector("[data-modal-open]") as HTMLButtonElement | null;
    const modal = card.querySelector("[data-modal]") as HTMLElement | null;

    if (!openButton || !modal) {
      return;
    }

    const closeTriggers = modal.querySelectorAll("[data-modal-close]");

    openButton.addEventListener("click", () => {
      modal.classList.add("is-open");
      document.body.classList.add("modal-open");
    });

    closeTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => closeModal(modal));
    });
  });

  window.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") {
      return;
    }

    const openModal = document.querySelector(".modal.is-open") as HTMLElement | null;
    closeModal(openModal);
  });
</script>
