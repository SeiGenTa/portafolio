---
interface Skill {
  name: string;
  icon: string;
}

interface Props {
  title: string;
  icon: string;
  skills: Skill[];
}

const { title, icon, skills } = Astro.props;
---

<div class="skill-card">
  <div class="card-header">
    <div class="icon-wrapper">
      <img src={icon} alt="" class="category-image" width="32" height="32" loading="lazy" />
    </div>
    <h3 class="category-title">{title}</h3>
  </div>

  <div class="skills-grid">
    {
      skills.map((skill) => (
        <div class="skill-item">
          <img
            src={skill.icon}
            alt=""
            class="skill-icon"
            width="18"
            height="18"
            loading="lazy"
          />
          <span class="skill-name">{skill.name}</span>
        </div>
      ))
    }
  </div>

  <div class="card-border" aria-hidden="true"></div>
</div>

<style>
  .skill-card {
    width: 100%;
    max-width: 300px;
    padding: 24px;
    background: linear-gradient(
      135deg,
      var(--card-bg) 0%,
      var(--surface-strong) 100%
    );
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    transition: all var(--transition);
    position: relative;
    overflow: hidden;
  }

  .skill-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--white-10),
      transparent
    );
    transition: left 0.5s ease;
    pointer-events: none;
  }

  .skill-card:hover::before {
    left: 100%;
  }

  .skill-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .icon-wrapper {
    width: 50px;
    height: 50px;
    background: var(--surface-strong);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition);
  }

  .skill-card:hover .icon-wrapper {
    background: var(--white-20);
    transform: scale(1.1);
  }

  .category-image {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .category-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.5px;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .skill-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    background: var(--surface);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    cursor: default;
  }

  .skill-item:hover {
    background: var(--white-12);
    transform: translateX(2px);
  }

  .skill-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
    flex-shrink: 0;
    opacity: 0.9;
  }

  .skill-name {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.2;
  }

  .card-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--white-20),
      transparent
    );
    opacity: 0.5;
  }
</style>
